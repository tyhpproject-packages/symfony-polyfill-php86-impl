{
    "name": "tyhpdef/symfony-polyfill-php86-impl",
    "description": "Implementation package for tyhpdef/symfony-polyfill-php86. Require tyhpdef/symfony-polyfill-php86, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "1.41.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/symfony-polyfill-php86"
        }
    },
    "require": {
        "php": ">=8.2",
        "symfony/polyfill-php86": "1.41.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    }
}
